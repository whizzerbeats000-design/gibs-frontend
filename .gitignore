# dependencies
node_modules

# build output
dist

# Playwright generated artifacts — regenerated by `npm run test:e2e`.
# These are also excluded from Tailwind's source scan (see src/index.css),
# so their class names cannot leak into the production stylesheet.
playwright-report/
test-results/
blob-report/
.playwright/

# archives
*.zip

# env — never commit secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*

# local review screenshots (visual evidence, not source)
after-*.png
programmes-catalogue-*.png
comparison-*.png

# python build artifacts
__pycache__/
*.py[cod]

# OS / IDE
.DS_Store
.vscode
.idea
.vercel

# stray full-page captures
scratch-*.png
