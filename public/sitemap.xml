<?xml version="1.0" encoding="UTF-8"?>
<!--
  Conservative interim sitemap for a hash-routed single-page app.

  The site is served as one document (dist/index.html); the view is selected
  by the URL fragment and the canonical is root-only (see index.html). All
  routes resolve to the same document, so only the root URL is a genuinely
  distinct, canonical indexable address. This interim sitemap lists that root
  URL only, consistent with the root-only canonical and og:url already in
  index.html.

  Per-route sitemap entries are omitted by design: listing clean paths such as
  /programmes would give Google URLs that all resolve to the same document and
  all canonicalise to the root, which is misleading. Route-level indexing can
  be revisited when the site gains per-route HTML (SSR or static export).

  Hash-fragment URLs (e.g. /#/programmes) are not valid sitemap entries.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://gibs.com.ng/</loc>
  </url>
</urlset>
